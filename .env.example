# ============================================================
# Copier ce fichier en .env.local et renseigner les valeurs
# ============================================================

# ────────────────────────────────────────────────────────────
# SUPABASE — Base de données PostgreSQL
# Dashboard → Project Settings → Database → Connection string
# ────────────────────────────────────────────────────────────

# Transaction Pooler (port 6543) — utilisé par Prisma au runtime
# Format : postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Connexion directe (port 5432) — utilisée par prisma migrate/push
# Format : postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ────────────────────────────────────────────────────────────
# AUTHENTIFICATION ADMIN (NextAuth v5)
# ────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl"
NEXTAUTH_URL="http://localhost:3000"

# Identifiants du compte admin unique
ADMIN_EMAIL="admin@association.ch"
ADMIN_PASSWORD="your-secure-password-here"

# ────────────────────────────────────────────────────────────
# EMAIL (Resend)
# ────────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
CONTACT_RECIPIENT_EMAIL="contact@association.ch"
CONTACT_FROM_EMAIL="noreply@association.ch"

# ────────────────────────────────────────────────────────────
# NEXT.JS
# ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
